build/
build-win/
*.o
*.a

# Extracted from the Windows NuGet package at CMake configure time — the
# .nupkg itself is the artifact of record.
sdk/windows/include/
sdk/windows/native/
.cache/
compile_commands.json
demos/pexninja/msvc/.vs

# Dev scratch / run logs
run.log
run_*.txt

# ImGui per-user window layout state
imgui.ini

# Local client configuration — contains registration credentials, never commit
pexninja-config.txt
pexclient-config.txt
uavwall-feeds.txt
uavwall.conf

# Editor / agent settings
.claude/

# macOS
.DS_Store

# Demo footage — large binaries, and usually not ours to redistribute
UAV_footage/

# Clips uavwall transcodes on import, cached beside its config. Derived from
# whatever the operator browsed to, so never ours to commit — and the same name
# is used for UAV_footage/prepared, which prepare-footage.sh generates.
prepared/

# Recordings written by uavwall. The folder is tracked so a fresh checkout has
# somewhere to write; the captures themselves never are.
recordings/*
!recordings/.gitkeep
*.mp4
*.crt
*.key
